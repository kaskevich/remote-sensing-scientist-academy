    "test:uav": "python3 scripts/validate_uav_training_pack.py",
    "test:smoke": "playwright test",
    "species:update": "python3 scripts/species/update_species_atlas.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
